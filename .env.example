# Copy this file to .env and fill in real values. Never commit the real .env.

# --- PostgreSQL ---
POSTGRES_USER=helixsync
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=helixsync

# --- Server ---
# Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=change-me-to-a-long-random-secret-at-least-32-bytes
# Comma-separated list of origins allowed to call the API with credentials.
# With the default single-origin setup (see WEB_API_BASE_URL below) the
# dashboard's calls are same-origin and never hit this check; it only
# matters if something calls the API directly from a browser context, e.g.
# a separately-hosted dashboard origin.
CORS_ALLOWED_ORIGINS=https://sync.example.com
# MUST be true for any production/public deployment. See docs/encryption.md.
REQUIRE_ENCRYPTION=true
# Not read from here for the docker-compose deployment (docker-compose.yml
# hardcodes BEHIND_PROXY=true for the `server` service, since it's always
# behind `web`'s nginx there). Only relevant if you run the `server` binary
# yourself outside docker-compose, directly behind your own trusted reverse
# proxy — set true so per-client rate limiting trusts that proxy's
# X-Forwarded-For/X-Real-IP headers instead of the raw connection address.
# Leave false (default) for any setup where the server is reachable without
# going through a trusted proxy first, e.g. local dev.
BEHIND_PROXY=false
ACCESS_TOKEN_TTL_SECS=900
REFRESH_TOKEN_TTL_SECS=2592000
WEB_SESSION_TTL_SECS=1209600
# How often the background operation/tombstone compaction task runs
# (docs/protocol.md §11). Default: hourly.
COMPACTION_INTERVAL_SECS=3600
# How long a tombstone-creating operation's raw log row is kept past the
# point compaction would otherwise delete it — a pure audit-trail safety
# margin (the tombstone's effect is independently durable regardless).
# Default: 30 days.
TOMBSTONE_RETENTION_SECS=2592000
RUST_LOG=info

# --- Ports (host side) ---
# The backend has no host port of its own — web/nginx.conf proxies /api/*
# to it over the internal docker network, so this is the only port a
# client (browser, extension) ever talks to.
WEB_PORT=5173

# --- Web build-time config ---
# Leave unset for the default single-origin setup (nginx proxies /api/* to
# the backend on the same origin as the dashboard). Only set this if the
# API is genuinely served from a different origin than the web dashboard.
WEB_API_BASE_URL=
