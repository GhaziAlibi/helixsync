{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "default_locale": "en",
  "version": "1.0.21",
  "description": "__MSG_extDescription__",
  "minimum_chrome_version": "116",
  "incognito": "not_allowed",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "HelixSync",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "bookmarks",
    "history",
    "tabs",
    "alarms",
    "contextMenus"
  ],
  "optional_permissions": [
    "tabGroups",
    "notifications"
  ],
  "optional_host_permissions": [
    "*://*/*",
    "ws://*/*",
    "wss://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
