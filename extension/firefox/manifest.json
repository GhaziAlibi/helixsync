{
  "manifest_version": 2,
  "name": "__MSG_extName__",
  "default_locale": "en",
  "version": "1.0.21",
  "description": "__MSG_extDescription__",
  "incognito": "not_allowed",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "bookmarks",
    "history",
    "tabs",
    "alarms",
    "contextMenus"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "helixsync@ghazialibi.github.io",
      "strict_min_version": "159.0",
      "data_collection_permissions": {
        "required": [
          "bookmarksInfo",
          "browsingActivity"
        ]
      }
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module",
    "persistent": true
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "HelixSync",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "optional_permissions": [
    "tabGroups",
    "notifications",
    "*://*/*",
    "ws://*/*",
    "wss://*/*"
  ],
  "content_security_policy": "script-src 'self'; object-src 'self'"
}
