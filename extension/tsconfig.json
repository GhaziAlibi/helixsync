{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["chrome", "vite/client"],
    // Shared code is type-checked against the Chrome implementation; both
    // implement the same Platform interface (src/platform.ts).
    "paths": { "@platform": ["./chrome/platform.ts"] }
  },
  "include": ["src", "chrome", "firefox"]
}
