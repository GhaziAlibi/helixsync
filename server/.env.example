# Settings for running the server directly from this directory (`cargo run`,
# `cargo test`). Copy to server/.env, which is git-ignored.
#
# The Docker Compose deployment does not read this file: it uses the .env in
# the repository root (see ../.env.example and docs/deployment.md).

# A local PostgreSQL 16 database. `cargo test` also needs the role to be able
# to create databases (CREATEDB or superuser): every integration test runs in
# its own throwaway database. Set up your own, or see CONTRIBUTING.md for a
# one-liner. The server applies server/migrations/ itself on startup.
DATABASE_URL=postgres://helix:helix@127.0.0.1:5432/helixsync

# Loopback only: local development has no TLS and no reverse proxy.
BIND_ADDR=127.0.0.1:8080

# Signs device access tokens. At least 32 characters, and the server refuses
# to start while it still contains "replace-me" or "change-me", so this
# placeholder MUST be replaced. Generate one with:
#   openssl rand -base64 48
JWT_SIGNING_KEY=replace-me-with-the-output-of-openssl-rand-base64-48

# On by default and best left that way: plaintext payloads are rejected, the
# way a real deployment behaves (docs/encryption.md). Only an explicit
# false/0 turns it off, and the server logs a warning at startup when it is off.
REQUIRE_ENCRYPTION=true

# Whether POST /api/v1/auth/register creates accounts (default true). Leave it
# on locally so you can register.
ALLOW_REGISTRATION=true

RUST_LOG=info
